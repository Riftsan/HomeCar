<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Scoped to HomeCar controls; the embedded dashboard keeps its own theme. -->
    <style name="Theme.HomeCar.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Reset inherited tint alpha; Material selectors retain their explicit disabled alpha. -->
        <item name="alpha">1</item>
        <item name="colorPrimary">@color/home_car_primary</item>
        <item name="colorOnPrimary">@color/home_car_on_primary</item>
        <item name="colorPrimaryContainer">@color/home_car_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/home_car_on_primary_container</item>
        <item name="colorSecondary">@color/home_car_primary</item>
        <item name="colorSecondaryContainer">@color/home_car_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/home_car_on_primary_container</item>
        <item name="colorSurface">@color/home_car_surface</item>
        <item name="colorOnSurface">@color/home_car_on_surface</item>
        <item name="colorSurfaceVariant">@color/home_car_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/home_car_on_surface_variant</item>
        <item name="colorOutline">@color/home_car_outline</item>
        <item name="colorOutlineVariant">@color/home_car_outline_variant</item>
        <item name="android:colorBackground">@color/home_car_surface</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.HomeCar.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
    </style>
    <style name="ThemeOverlay.HomeCar.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.HomeCar.BottomSheet</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Widget.HomeCar.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.HomeCar.Sheet</item>
    </style>
    <style name="ShapeAppearanceOverlay.HomeCar.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>
    <style name="Widget.HomeCar.Action" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="cornerRadius">20dp</item>
    </style>
    <style name="Widget.HomeCar.TextAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
    </style>
    <style name="Widget.HomeCar.OutlinedAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
